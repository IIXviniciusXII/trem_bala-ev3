#!/usr/bin/env pybricks-micropython
from pybricks.hubs import EV3Brick
from pybricks.ev3devices import Motor, ColorSensor
from pybricks.parameters import Port, Direction
from pybricks.tools import wait


ev3 = EV3Brick()


# =========================
# MOTORES
# =========================

motor_esquerdo = Motor(
    Port.A,
    positive_direction=Direction.CLOCKWISE
)

motor_direito = Motor(
    Port.B,
    positive_direction=Direction.CLOCKWISE
)


# =========================
# SENSORES
# =========================

S1 = ColorSensor(Port.S1)  # DIREITA
S2 = ColorSensor(Port.S2)  # ESQUERDA
S3 = ColorSensor(Port.S3)  # CENTRO
S4 = ColorSensor(Port.S4)  # MARCAÇÕES


# =========================
# CALIBRAÇÃO
# =========================

S1_PRETO = 30
S1_BRANCO = 74.5

S2_PRETO = 30
S2_BRANCO = 100

S3_PRETO = 30
S3_BRANCO = 100

S4_PRETO = 30
S4_BRANCO = 100


# =========================
# PID / CONTROLE
# =========================

KP = 0.46
KI = 0.0001
KD = 0.27


# =========================
# VELOCIDADES
# =========================

VELOCIDADE_RETA = 100
VELOCIDADE_CURVA = 55

velocidade_atual = 90


# =========================
# CONTAGEM DE MARCAÇÕES
# =========================

# Para parar o robô numa marcação específica, coloque o número aqui.
# 0 = nunca para (só conta).
PARAR_NA_MARCACAO = 6

LIMIAR_MARCACAO_ENTRA = 65   # acima disso = em cima da marcação
LIMIAR_MARCACAO_SAI = 40     # abaixo disso = saiu da marcação
CICLOS_CONFIRMACAO = 1       # ciclos seguidos para confirmar a leitura

contagem_marcacoes = 0
sobre_marcacao = False
ciclos_marcacao = 0


# =========================
# ESTADOS
# =========================

erro_anterior = 0
derivada_filtrada = 0
integral_filtrada = 0

correcao_anterior = 0

# -1 = esquerda
#  1 = direita
ultima_direcao = 0

# Memória da curva
curva_memoria = 0
modo_reta = 0
alinhado = 0


# =========================
# FUNÇÃO DE NORMALIZAÇÃO
# =========================

def normalizar(valor, preto, branco):

    resultado = ((valor - preto) / (branco - preto)) * 100

    if resultado < 0:
        resultado = 0

    if resultado > 100:
        resultado = 100

    return resultado


# =========================
# TELA INICIAL
# =========================

ev3.screen.clear()
ev3.screen.print("Marcacoes: 0")


# =========================
# LOOP PRINCIPAL
# =========================

while True:

    # -------------------------
    # LEITURA DOS SENSORES
    # -------------------------

    r1 = S1.reflection()
    r2 = S2.reflection()
    r3 = S3.reflection()
    r4 = S4.reflection()


    # -------------------------
    # NORMALIZAÇÃO
    # -------------------------

    s1 = normalizar(r1, S1_PRETO, S1_BRANCO)
    s2 = normalizar(r2, S2_PRETO, S2_BRANCO)
    s3 = normalizar(r3, S3_PRETO, S3_BRANCO)
    s4 = normalizar(r4, S4_PRETO, S4_BRANCO)


    # ==================================================
    # CONTAGEM DE MARCAÇÕES (S4)
    # ==================================================

    if s4 > LIMIAR_MARCACAO_ENTRA:

        ciclos_marcacao += 1

        # Conta só uma vez por marcação
        if ciclos_marcacao >= CICLOS_CONFIRMACAO and not sobre_marcacao:

            sobre_marcacao = True
            contagem_marcacoes += 1

            ev3.screen.clear()
            ev3.screen.print("Marcacoes:", contagem_marcacoes)
            ev3.speaker.beep()

    elif s4 < LIMIAR_MARCACAO_SAI:

        # Saiu da marcação: libera para contar a próxima
        ciclos_marcacao = 0
        sobre_marcacao = False


    # Parada opcional numa marcação específica
    if PARAR_NA_MARCACAO > 0 and contagem_marcacoes >= PARAR_NA_MARCACAO:
        motor_esquerdo.stop()
        motor_direito.stop()
        break


    # ==================================================
    # 1. DESCOBRIR A POSIÇÃO DA LINHA
    # ==================================================

    soma = s1 + s2 + s3


    if soma > 8:

        # S2 = esquerda = negativo
        # S3 = centro   = zero
        # S1 = direita  = positivo

        erro = ((s1 * 100) - (s2 * 100)) / soma

    else:

        # Linha perdida.
        # NÃO zeramos o erro.
        # Mantemos a direção anterior.

        erro = erro_anterior


    # ==================================================
    # 2. MEMÓRIA DA DIREÇÃO DA CURVA
    # ==================================================

    # CURVA PARA ESQUERDA
    if s2 > 30 and s2 > s1 + 10:

        ultima_direcao = -1

        curva_memoria -= 1

        if curva_memoria < -10:
            curva_memoria = -10

    # CURVA PARA DIREITA
    elif s1 > 30 and s1 > s2 + 10:

        ultima_direcao = 1

        curva_memoria += 1

        if curva_memoria > 10:
            curva_memoria = 10

    else:

        # Sem curva externa clara: a memória decai devagar.

        if curva_memoria > 0:
            curva_memoria -= 1.2

            if curva_memoria < 0:
                curva_memoria = 0

        elif curva_memoria < 0:
            curva_memoria += 1.2

            if curva_memoria > 0:
                curva_memoria = 0


    # ==================================================
    # 3. SE O CENTRO PEGOU A LINHA, ESTABILIZA A CURVA
    # ==================================================

    if s3 > 75:

        curva_memoria *= 0.75


    # =========================
    # MODO DE ESTABILIZAÇÃO
    # =========================

    if s3 > 70 and s1 < 30 and s2 < 30:

        alinhado += 1

    else:

        alinhado = 0


    # Centro alinhado por alguns ciclos = curva terminou.

    if alinhado >= 7:

        modo_reta = 1

        curva_memoria *= 0.25

    else:

        modo_reta = 0


    # Ajuste extra para alinhar em linha reta.
    if s3 > 55 and s1 < 40 and s2 < 40:
        erro = erro * 0.45


    # ==================================================
    # 4. DERIVADA + INTEGRAL
    # ==================================================

    derivada = erro - erro_anterior

    integral_filtrada = (integral_filtrada * 0.80) + (erro * 0.20)

    derivada_filtrada = (
        derivada_filtrada * 0.65
        + derivada * 0.35
    )

    erro_anterior = erro


    # ==================================================
    # 5. CORREÇÃO PRINCIPAL
    # ==================================================

    correcao_pid = (
        KP * erro
        + KI * integral_filtrada
        + KD * derivada_filtrada
    )


    # ==================================================
    # 6. MEMÓRIA DA CURVA
    # ==================================================

    correcao = correcao_pid + curva_memoria


    # ==================================================
    # ESTABILIZAÇÃO DA RETA
    # ==================================================

    if modo_reta == 1:

        correcao *= 0.06

    elif abs(erro) < 8:
        correcao *= 0.18

    elif abs(erro) < 22:
        correcao *= 0.35

    else:
        correcao *= 0.62


    # ==================================================
    # 7. LIMITAR A CORREÇÃO
    # ==================================================

    if correcao > 58:
        correcao = 58

    if correcao < -58:
        correcao = -58


    # ==================================================
    # 8. NÃO DEIXAR A CORREÇÃO DAR UM "PULO"
    # ==================================================

    diferenca = correcao - correcao_anterior

    if diferenca > 3.0:
        correcao = correcao_anterior + 3.0

    elif diferenca < -3.0:
        correcao = correcao_anterior - 3.0

    correcao_anterior = correcao


    # ==================================================
    # 9. VELOCIDADE
    # ==================================================

    intensidade_curva = abs(erro)

    # Curva forte
    if intensidade_curva > 80:
        velocidade_alvo = 50
    if intensidade_curva > 65:
        velocidade_alvo = 50


    # Curva média
    elif intensidade_curva > 40:
        velocidade_alvo = 50

    elif intensidade_curva > 25:
        velocidade_alvo = 50

    elif intensidade_curva > 12:
        velocidade_alvo = 50

    # Reta
    else:
        velocidade_alvo = 98


    # Sensor externo detectando curva
    if s2 > 60 or s1 > 60:
        correcao *= 0.70

        if velocidade_alvo > 64:
            velocidade_alvo = 64


    # Marcações
    if s4 > 65:
        velocidade_alvo -= 5


    # Linha perdida
    if soma <= 8:
        velocidade_alvo = 40


    if velocidade_alvo < VELOCIDADE_CURVA:
        velocidade_alvo = VELOCIDADE_CURVA

    if velocidade_alvo > VELOCIDADE_RETA:
        velocidade_alvo = VELOCIDADE_RETA


    # ==================================================
    # 10. ACELERAÇÃO / DESACELERAÇÃO
    # ==================================================

    if velocidade_atual < velocidade_alvo:

        velocidade_atual += 3

        if velocidade_atual > velocidade_alvo:
            velocidade_atual = velocidade_alvo

    else:

        velocidade_atual -= 4

        if velocidade_atual < velocidade_alvo:
            velocidade_atual = velocidade_alvo


    # ==================================================
    # 11. MOTORES
    # ==================================================

    esquerda = velocidade_atual + correcao
    direita = velocidade_atual - correcao

    if esquerda > 100:
        esquerda = 100

    if esquerda < -100:
        esquerda = -100

    if direita > 100:
        direita = 100

    if direita < -100:
        direita = -100

    # IMPORTANTE:
    # No seu robô, negativo = andar para frente

    motor_esquerdo.dc(-int(esquerda))
    motor_direito.dc(-int(direita))

    wait(1)
